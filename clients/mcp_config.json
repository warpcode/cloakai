{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agents": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network",
        "cloakai-internal",
        "-e",
        "OPENAI_API_KEY",
        "cloakai/dev:latest",
        "mcp"
      ],
      "disabled": false
    }
  }
}
