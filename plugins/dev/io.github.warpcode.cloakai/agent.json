{
  "$comment": "The ONLY file that must change when the runtime changes. If this starts growing capability logic, that logic belongs in the gateway, not here.",
  "description": "Development agent. Reviews changes for correctness, security and maintainability, and writes release notes from a diff. Use for code review, pull request feedback, and preparing a release summary.",
  "instructions": [
    "skills/"
  ],
  "runtime": "opencode",
  "image": "cloakai/dev:latest",
  "upstream": {
    "provider": "openai",
    "id": "default",
    "base_url": "http://litellm:4000/v1"
  },
  "entrypoints": {
    "run": "opencode run --auto",
    "mcp": "docker-agent serve mcp /agent/agent.yaml -a dev --http --listen 0.0.0.0:8081 --insecure-no-auth"
  },
  "limits": {
    "cpus": "2",
    "memory": "4g",
    "pids": 1024
  },
  "isolation": {
    "network": "internal",
    "read_only": true,
    "tmpfs": [
      "/tmp",
      "/root/.local",
      "/root/.config",
      "/root/.cache"
    ],
    "cap_drop": [
      "ALL"
    ],
    "no_new_privileges": true
  },
  "mcp_servers": [
    "agents"
  ],
  "env": {
    "OPENCODE_API_KEY": "{{key}}",
    "OPENCODE_DISABLE_MODELS_FETCH": "1",
    "OPENCODE_CONFIG_CONTENT": "{\"model\":\"cloakai/{{model}}\",\"provider\":{\"cloakai\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"cloakai proxy\",\"options\":{\"baseURL\":\"{{base_url}}\",\"apiKey\":\"{{key}}\"},\"models\":{\"{{model}}\":{\"name\":\"{{model}}\"}}}},\"permission\":{\"edit\":\"allow\",\"bash\":\"allow\"}}"
  }
}
