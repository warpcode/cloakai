{
  "$comment": "The ONLY file that must change when the runtime changes. If this starts growing capability logic, that logic belongs in the gateway, not here.",
  "description": "Development agent. Reviews changes for correctness, security and maintainability, and writes release notes from a diff. Use for code review, pull request feedback, and preparing a release summary.",
  "instructions": [
    "skills/"
  ],
  "runtime": "opencode",
  "image": "cloakai/dev:latest",
  "upstream": {
    "provider": "opencode",
    "id": "big-pickle",
    "base_url": "https://opencode.ai/zen/v1"
  },
  "entrypoints": {
    "run": "opencode run --auto",
    "mcp": "docker-agent serve mcp /agent/agent.yaml -a dev",
    "mcp_http": "docker-agent serve mcp /agent/agent.yaml -a dev --http --listen 0.0.0.0:8081 --insecure-no-auth",
    "run_cmd": "opencode run --auto"
  },
  "limits": {
    "cpus": "2",
    "memory": "4g",
    "pids": 1024
  },
  "isolation": {
    "network": null,
    "read_only": true,
    "tmpfs": [
      "/tmp",
      "/root/.local",
      "/root/.config",
      "/root/.cache"
    ],
    "cap_drop": [
      "ALL"
    ],
    "no_new_privileges": true
  },
  "mcp_servers": [
    "agents"
  ]
}
